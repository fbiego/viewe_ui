<component>
	<styles>
		<style
			name="style_main"
			width="content"
			height="content"
			radius="0"
			pad_all="0"
			bg_opa="0"
			border_width="0"
			layout="flex"
			flex_track_place="center"
			flex_cross_place="center"
		/>
		<style
			name="style_dot"
			width="20"
			height="20"
			radius="10"
			bg_color="0x2c0fe1"
			bg_opa="0"
			pad_all="0"
			border_color="0x2c0fe1"
		/>
		<style name="style_dot_checked" bg_opa="255" />
		<style name="style_dot_pressed" border_width="3" bg_opa="127" />
	</styles>
	<api>
		<prop name="text" type="string" default="Radio" />
	</api>
	<view state_trickle="true">
		<style name="style_main" />
		<lv_obj clickable="false">
			<style name="style_dot" />
			<style name="style_dot_checked" selector="checked" />
			<style name="style_dot_pressed" selector="pressed" />
		</lv_obj>
		<lv_label text="$text" />
	</view>
</component>
